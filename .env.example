# --- database (docker pgvector on llmhost2) ---
POSTGRES_DB=kanban
POSTGRES_USER=kanban
POSTGRES_PASSWORD=kanban
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# --- django ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,192.168.10.7

# where gunicorn listens. Loopback only by default. Set the LAN address to
# reach the board from other machines. Do NOT use 0.0.0.0.
BIND_ADDR=127.0.0.1:8901

# --- agent provider: fake | local_llama | local_vllm | minimax | qwen ---
AGENT_PROVIDER=fake
AGENT_LOCAL_LLAMA_BASE_URL=http://127.0.0.1:8080/v1
AGENT_LOCAL_LLAMA_MODEL=
AGENT_LOCAL_VLLM_BASE_URL=http://127.0.0.1:8000/v1
AGENT_MINIMAX_BASE_URL=
AGENT_MINIMAX_API_KEY=
AGENT_QWEN_BASE_URL=
AGENT_QWEN_API_KEY=

# --- runtime tuning (part 2 consumes these) ---
TASK_LEASE_SECONDS=900
TASK_HEARTBEAT_SECONDS=10
TASK_DEFAULT_MAX_ATTEMPTS=3
TASK_DEFAULT_MAX_TOKENS=200000
MAX_DEPTH=4
